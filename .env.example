# tick-collector environment — copy to `.env` and fill in.
#
# This is the only file you should need to edit to deploy. Dockge gives you an
# editor for it alongside the compose file. `.env` is git-ignored and must never
# be committed.
#
# Every value below has a working default except the API key.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Your Massive (formerly Polygon.io) API key. The collector reads it from the
# environment only; it is never written to logs, status.json or the manifest, and
# a logging filter strips it even from URLs that get logged by accident.
MASSIVE_API_KEY=

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------

# Host directory for all collected data. Must be on the array (this grows to
# gigabytes) and must be writable by APP_UID:APP_GID below.
#
# Create it before the first deploy, or Docker will create it owned by root and
# the container will refuse to start:
#   mkdir -p /mnt/user/quant-data && chown 99:100 /mnt/user/quant-data
#
# published/, staging/, quarantine/, state/ and logs/ are all created inside it
# and must stay on one filesystem, so point this at a single share.
COLLECTOR_DATA_DIR=/mnt/user/quant-data

# Owner of the directory above. Unraid shares are nobody:users = 99:100.
# Check yours with: stat -c '%u %g' /mnt/user/quant-data
APP_UID=99
APP_GID=100

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Log timestamps only. The scheduler's own timezone is set in
# config/collector.toml, so the two cannot drift apart.
TZ=America/New_York

# INFO is right for normal running. DEBUG is very chatty (one line per API call).
COLLECTOR_LOG_LEVEL=INFO

# Image tag. Bump it to force a rebuild on the next deploy.
COLLECTOR_VERSION=0.1.0

# Container memory ceiling.
COLLECTOR_MEM_LIMIT=2g

# Docker log rotation, so the cache drive cannot fill.
COLLECTOR_LOG_MAX_SIZE=16m
COLLECTOR_LOG_MAX_FILE=5

# Webhook for hard failures and recoveries. Works with Slack, Discord, ntfy,
# Gotify and most self-hosted receivers without any format configuration. Treated
# as a secret: redacted from logs and status.json like the API key.
# Test it with: docker exec tick-collector python -m collector alert-test
# COLLECTOR_ALERT_WEBHOOK=

# Host directory for backups, if you enable the nightly backup job. Uncomment the
# matching volume in compose.yaml and set [backup] directory = "/backups" in
# config/collector.toml. Use a different share from the data.
# COLLECTOR_BACKUP_DIR=/mnt/user/backups/tick-collector
